---
import "@fontsource-variable/familjen-grotesk/wght.css";
import "@fontsource-variable/familjen-grotesk/wght-italic.css";
import { getCollection } from "astro:content";
import { url } from "../lib/url";
import "../styles/global.css";

interface Props {
  title?: string;
  // Header sits on top of a full-screen image (front page).
  overlay?: boolean;
}

const { title, overlay = false } = Astro.props;
const siteTitle = "Stina Brockman";
const pages = (await getCollection("pages")).sort((a, b) => a.data.order - b.data.order);
const nav = [{ path: "/", label: "Work" }, ...pages.map((p) => ({ path: `/${p.id}`, label: p.data.title }))];
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const current = Astro.url.pathname.slice(base.length).replace(/\/$/, "") || "/";
const isCurrent = (path: string) =>
  path === "/" ? current === "/" || current.startsWith("/work") : current === path;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Stina Brockman, photographer and artist, Stockholm." />
    <link rel="icon" type="image/svg+xml" href={url("/favicon.svg")} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <title>{title ? `${title} — ${siteTitle}` : siteTitle}</title>
  </head>
  <body class:list={{ "has-overlay": overlay }}>
    <a class="skip-link" href="#content">Skip to content</a>
    <header class="site-header">
      <a class="site-title" href={url("/")}>{siteTitle}</a>
      <nav class="site-nav" aria-label="Main">
        {
          nav.map((item) => (
            <a href={url(item.path)} aria-current={isCurrent(item.path) ? "page" : undefined}>
              {item.label}
            </a>
          ))
        }
      </nav>
    </header>
    <main id="content">
      <slot />
    </main>
    <footer class="site-footer">© {new Date().getFullYear()} {siteTitle}</footer>
  </body>
</html>
